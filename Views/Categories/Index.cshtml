@{
    ViewData["Title"] = "Categories";
}
@model Category[]

@section title {
    <h1 class="display-4">@ViewData["Title"]</h1>
}

 <!-- BODY -->
@if (Model.Length > 0)
{
    <table class="table table-dark">
        <thead>
            <tr>
            <th scope="col">ID</th>
            <th scope="col">Nombre</th>
            <th scope="col">Descripción</th>
            <th scope="col">Acciones</th>
        </tr>
        </thead>
        <tbody>
        @foreach (var cat in Model)
        {
            <tr>
                <th scope="row">@cat.Id</th>
                <td>@cat.Name</td>
                <td>@cat.Description</td>
                <td><a class="btn btn-link" asp-controller="Categories" asp-action="Edit" asp-route-id="@cat.Id">Edit</a></td>
                <!-- <td><a class="btn btn-link" href="categories/edit/@cat.Id">Edit</a></td>-->
                <!-- <td><a class="btn btn-link" href="@($"categories/edit/{cat.Id}")">Edit</a></td> -->
            </tr>
        }
        </tbody>
    </table>
}