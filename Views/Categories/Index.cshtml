@{
    ViewData["Title"] = "Categorias";
}
@model Category[]

@section title {
    <h1 class="display-4">@ViewData["Title"]</h1>
}

<!-- BODY -->
@if (Model.Length > 0)
{
    <table class="table">
        <thead>
        <tr>
            <th scope="col">ID</th>
            <th scope="col">Nombre</th>
            <th scope="col">Descripción</th>
            <th scope="col">Editar</th>
            <th scope="col">Borrar</th>
        </tr>
        </thead>
        <tbody>
        @foreach (var cat in Model)
        {
            <tr>
                <th scope="row">@cat.Id</th>
                <td>@cat.Name</td>
                <td>@cat.Description</td>
                <td><a class="btn btn-link" asp-controller="Categories" asp-action="Edit"
                       asp-route-id="@cat.Id">Editar</a></td>
                <td><a class="btn btn-link" asp-controller="Categories" asp-action="Delete"
                       asp-route-categoryId="@cat.Id" onclick="return confirmDelete()">Borrar</a></td>
                <!-- <td><a class="btn btn-link" href="categories/edit/@cat.Id">Edit</a></td>-->
                <!-- <td><a class="btn btn-link" href="@($"categories/edit/{cat.Id}")">Edit</a></td> -->
            </tr>
        }
        </tbody>
    </table>
    <a class="btn btn-primary" asp-controller="Categories" asp-action="Add" role="button">Agregar</a>
}

@section Scripts
{
    <script>
        function confirmDelete() {
            return confirm("¿Estás seguro que desea eliminar esta categoria?");
        }
    </script>
}





