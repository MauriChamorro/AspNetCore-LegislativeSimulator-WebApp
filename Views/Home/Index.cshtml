@{
    ViewData["Title"] = "Página de Inicio";
}

@section title { }
<div class="container text-center">
    <h1 class="fw-bold text-dark mb-3">Simulador Legislativo</h1>
    <p class="lead text-body mb-4">
        Prototipo minimalista interactivo sobre la creación de Proyectos de Ley, su seguimiento y simulación de resultados.
    </p>
    
    <p class="lead text-body mb-4">Para poder Crear y Gestionar tus proyectos, debes iniciar sesión como Legislador. Las mismas credenciales se encuentran en el repositorio del proyecto.</p>
    <div class="d-flex justify-content-center gap-2">
        @{
            if (!User.Identity.IsAuthenticated)
            {
                <a asp-controller="Account" asp-action="Login" class="btn btn-primary">Iniciar Sesión</a>
            }
            if (User.Identity.IsAuthenticated)
            {
                <a asp-controller="Projects" asp-action="Index" class="btn btn-success">Mis Proyectos</a>
            }
        }
        <a href="https://github.com/MauriChamorro/AspNetCore-LegislativeSimulator-WebApp" target="_blank" rel="noopener noreferrer" class="btn btn-outline-dark">
            <i class="bi bi-github"></i> Repositorio
        </a>
    </div>
    
</div>