@model ProjectReferralCommissionsViewModel

@section title{
    <h2>@Model.ProjectId - @Model.ProjectTitle</h2>
    <h3>Comisiones evaluando</h3>
}

<table class="table">
    <thead>
    <tr class="fs-5">
        <th scope="col">Nombre de Comisión</th>
        <th scope="col">Estado de Giro</th>
        <th scope="col">Fecha de Giro</th>
    </tr>
    </thead>
    <tbody>
    @foreach (var commission in Model.ReferralCommissions)
    {
        <tr>
            <th scope="row"
                style="background-color: @commission.BackgroundColor; color: @commission.Color;">@commission.CommissionName </th>
            <td style="background-color: @commission.BackgroundColor; color: @commission.Color;">@commission.ReferralStateName</td>
            <td style="background-color: @commission.BackgroundColor; color: @commission.Color;">@commission.ReferralDate.ToString("dd/MM/yyyy")</td>
        </tr>
    }
    </tbody>
</table>
<div class="d-flex">
    <a class="btn btn-primary" asp-controller="Projects" asp-action="Index" role="button">Volver</a>
</div>