@model EditProjectAdminVm

@{
    ViewData["title"] = "Modificar Proyecto";
    ViewData["subtitle"] = "";
}

@section title {
    <partial name="_Title"/>
}

<form method="get" asp-controller="Admin" asp-action="EditProject" class="d-flex">
    <input class="form-control me-sm-2"
           type="search"
           name="projectTxtId"
           placeholder="Número de Proyecto"
           value=@TempData["searchText"]>
    <button class="btn btn-secondary my-2 my-sm-0" type="submit">Buscar</button>
</form>
<br/>
<br/>
<table class="table border">
    <thead>
    <tr>
        <th scope="col">Nro</th>
        <th scope="col">Título</th>
        <th scope="col">Resumen</th>
        <td class="text-center" style="background-color: #fff7d9">Estado</td>
    </tr>
    </thead>
    <tbody>
    <tr>
        <th scope="row">@Model.ProjectId</th>
        <td>@Model.Title</td>
        <td>@Model.Summary</td>
        <td class="text-center fw-bold" style="background-color: #fff7d9">@Model.StateName?.ToUpper()</td>
    </tr>
    </tbody>
</table>

@if (Model.ProjectId !=0 && Model.EnumState == FileState.PendingForAssignCommissions)
{
    <form method="post" asp-controller="Admin" asp-action="AssignCommissions" asp-route-projectId="@Model.ProjectId">
        <button type="submit" class="btn btn-warning">
            Asignar Comisiones automaticamente
        </button>
    </form>
}
@if (Model.ProjectId !=0 && Model.EnumState == FileState.InCommission)
{
    <form method="post" asp-controller="Admin" asp-action="DoNextReferringRandomly" asp-route-projectId="@Model.ProjectId">
        <button type="submit" class="btn btn-warning">
            Realizar siguiente Giro al azar
        </button>
    </form>
}

@if (Model.ProjectId !=0 && Model.EnumState == FileState.InSession)
{
    <form method="post" asp-controller="Admin" asp-action="DoSessionRandomly" asp-route-projectId="@Model.ProjectId">
        <button type="submit" class="btn btn-warning">
            Realizar Sesión al azar
        </button>
    </form>
}