<header>
    <nav class="navbar navbar-expand-lg bg-primary" data-bs-theme="dark">
        <div class="container-fluid">
            <a class="navbar-brand" asp-area="" asp-controller="Home" asp-action="Index">ExpedientesAr</a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarColor01"
                    aria-controls="navbarColor01" aria-expanded="false" aria-label="Toggle navigation">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse" id="navbarColor01">
                <ul class="navbar-nav me-auto">
                    @{
                        string? controllerName = ViewContext.RouteData.Values["controller"]?.ToString();
                        string? actionName = ViewContext.RouteData.Values["action"]?.ToString();
                    }
                    <li class="nav-item">
                        <a class="nav-link @(controllerName == "Home" && actionName == "Index" ? "active" : "")"
                           asp-controller="Home" asp-action="Index">Inicio
                            <span class="visually-hidden">(current)</span>
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link @(controllerName == "Projects" && actionName == "Index" ? "active" : "")" 
                           asp-controller="Projects" asp-action="Index">Mis Proyectos</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link @(controllerName == "Home" && actionName == "Privacy" ? "active" : "")" 
                           asp-controller="Home" asp-action="Privacy">Privacidad</a>
                    </li>
                    @if (User.IsInRole("admin"))
                    {
                        <li class="nav-item dropdown">
                            <a class="nav-link dropdown-toggle @(controllerName == "Admin" ? "active" : "")" data-bs-toggle="dropdown" href="#" role="button" aria-haspopup="true" aria-expanded="false">Admin</a>
                            <div class="dropdown-menu">
                                <a class="dropdown-item" asp-controller="Admin" asp-action="EditProject">Modificar Proyecto</a>
                            </div>
                        </li>
                    }
                </ul>
            </div>
            <div class="mr-2" style="margin-right: 20px">
                @{
                    if (User.Identity.IsAuthenticated)
                    {
                        <form method="post" asp-controller="Account" asp-action="Logout">
                            <!--<a type="submit" class="link-light">Logout</a> !-->
                            <button type="submit" class="btn text-white">Salir</button>
                        </form>
                    }
                    else
                    {
                        <a class="btn text-white" asp-controller="Account" asp-action="Login">Ingresar</a>
                    }
                }
            </div>
        </div>
    </nav>
</header>