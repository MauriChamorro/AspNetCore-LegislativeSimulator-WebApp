<script src="~/lib/jquery/dist/jquery.min.js"></script>
<script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
<script src="~/js/site.js" asp-append-version="true"></script>
<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
<script>
    function ShowModal(title, message, type) {
        Swal.fire({
            title: title || 'Notificación',
            text: message,
            icon: type || 'info', // Si no hay icono, por defecto info
            timer: null,
            timerProgressBar: false,
            showConfirmButton: true,
            confirmButtonText: 'Aceptar',
            confirmButtonColor: '#3085d6',
            allowOutsideClick: false,
            allowEscapeKey: false
        });
    }
</script>
@if (User.IsInRole("admin"))
{
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            var adminNoti = '@Html.Raw(TempData["adminNoti"])';
            if (adminNoti) {
                var message = '@Html.Raw(TempData["message"])';
                var type = '@TempData["icon"]';
                ShowModal(adminNoti, message, type);
            }
        });
    </script>
}

@if (User.IsInRole("legislador"))
{
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            var userNoti = '@Html.Raw(TempData["userNoti"])';
            if (userNoti) {
                var message = '@Html.Raw(TempData["SwalMessage"])';
                var type = '@TempData["SwalIcon"]';
                ShowModal(userNoti, message, type);
            }
        });
    </script>
}
