@model ProjectViewModel

@section title
{
    <h2>@Model.Title</h2>
    <h3>[@Model.StateName]</h3>
    @if (Model.Commissions != null && !Model.CanEdit)
    {
        foreach (var commissionVm in Model.Commissions)
        {
            <span class="badge @commissionVm.Color">@commissionVm.Name</span>
        }
    }
}

<partial name="_Projects" model="Model"/>
