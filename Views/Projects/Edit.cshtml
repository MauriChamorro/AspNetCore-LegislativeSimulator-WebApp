@model ProjectViewModel

@section title
{
    <h2>@Model.Title</h2>
    <h3>[@Model.StateName]</h3>
    @if (Model.Commissions != null && !Model.CanEdit)
    {
        foreach (var commissionVm in Model.Commissions)
        {
            <span class="badge @commissionVm.Color">@commissionVm.Name</span>
        }
    }
}

@await Html.PartialAsync("_Projects", Model, ViewData)


@section Scripts
{
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            const sendToCommission = document.getElementById("send-to-commission-element");
            if (sendToCommission) {
                sendToCommission.addEventListener("click", function (event) {
                    event.preventDefault();
                    const message = event.target.getAttribute("data-message")
                    const actionText = event.target.getAttribute("data-success-text");
                    const url = event.target.getAttribute("data-url")

                    confirmSending(message, actionText, url);
                })
            }
        })

        function confirmSending(modalTitle, actionTxt, url) {
            Swal.fire({
                title: modalTitle,
                text: "Esta acción no podrá deshacerse.",
                icon: 'question',
                showCancelButton: true,
                confirmButtonColor: '#198754',
                cancelButtonColor: '#dc3545',
                confirmButtonText: actionTxt,
                cancelButtonText: 'Cancelar'
            }).then((result) => {
                console.log('sending --> ' + url);
                if (result.isConfirmed) {
                    const form = document.getElementById('formExpediente');
                    form.action = url;
                    form.submit();
                }
            });
        }
    </script>
}
