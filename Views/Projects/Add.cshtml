@model WebAppMVC.Domain.Models.Projects.Project

@section title
{
    <h2>@Model.Title</h2>
}

<form>
    <div class="row mb-3">
        <div class="col-2">
            <label class="col-form-label">Nombre</label>
        </div>
        <div class="col-6">
            <input type="text" readonly="" asp-for="@Model.Title" class="form-control"/>
        </div>
        <div class="col">
            <span class="text-danger" asp-validation-for="@Model.Title"></span>
        </div>
    </div>
</form>