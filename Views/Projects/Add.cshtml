@model WebAppMVC.Domain.Models.Projects.Project

@section title
{
    <h2>@Model.Title [@Model.State.ProjectStateName]</h2>
}

<form>
    <div class="row mb-3">
        <div class="col-2">
            <label class="col-form-label">Nro Expediente</label>
        </div>
        <div class="col-sm-10">
            <input type="text" class="form-control-plaintext fw-bold" value="@Model.Id">
        </div>
    </div>
    <div id="title" class="row mb-3">
        <div class="col-2">
            <label class="col-form-label">Título</label>
        </div>
        <div class="col-6">
            <input type="text" asp-for="@Model.Title" class="form-control"/>
        </div>
        <div class="col">
            <span class="text-danger" asp-validation-for="@Model.Title"></span>
        </div>
    </div>
    <div>
        <label asp-for="@Model.Articles" class="form-label mt-4">Artículos</label>
        <textarea class="form-control" id="articles" rows="5" ></textarea>
    </div>
    <div>
        <label asp-for="@Model.Fundaments" class="form-label mt-4">Fundamentos</label>
        <textarea class="form-control" id="fundaments" rows="5" ></textarea>
    </div>
    <br/>
    <div id="summary" class="row mb-3">
        <div class="col-2">
            <label class="col-form-label">Resúmen</label>
        </div>
        <div class="col-6">
            <input type="text" asp-for="@Model.Summary" class="form-control"/>
        </div>
        <div class="col">
            <span class="text-danger" asp-validation-for="@Model.Title"></span>
        </div>
    </div>
</form>