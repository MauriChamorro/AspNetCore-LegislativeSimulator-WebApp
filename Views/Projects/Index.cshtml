@model List<ProjectViewModel>

@{
    ViewData["title"] = "Mis Proyectos";
    ViewData["subtitle"] = "";
}

@section title {
    <partial name="_Title"/>
}

@{
    <table class="table">
        <thead>
        <tr>
            <th scope="col">Nro Expediente</th>
            <th scope="col">Título</th>
            <th scope="col" style="background-color: #fff7d9">Estado</th>
            <th scope="col">Fecha Estado</th>
        </tr>
        </thead>
        <tbody>
        @foreach (var @projectVm in Model)
        {
            <tr>
                <th scope="row">@projectVm.ProjectId</th>
                <td>@projectVm.Title</td>
                <td style="background-color: #fff7d9">@projectVm.StateName</td>
                <td>@projectVm.StateDate.ToString("dd/MM/yyyy")</td>

                @if (projectVm.CanEdit)
                {
                    <td>
                        <a class="btn btn-success" asp-controller="Projects" asp-action="Edit"
                           asp-route-projectId="@projectVm.ProjectId">Editar</a>
                    </td>
                }
                else
                {
                    <td>
                        <a class="btn btn-success" asp-controller="Projects" asp-action="Edit"
                           asp-route-projectId="@projectVm.ProjectId">Ver</a>
                    </td>
                }
                @if (projectVm.InCommission)
                {
                    <td>
                        <a class="btn btn-secondary" asp-controller="ReferralCommittees" asp-action="Index"
                           asp-route-projectId="@projectVm.ProjectId">Comisiones</a>
                    </td>
                }
                @if (projectVm.CanSendToSession)
                {
                    <td>
                        <a class="btn btn-outline-info" asp-controller="Projects" asp-action="SendToSession"
                           asp-route-projectId="@projectVm.ProjectId">Enviar a Sesión</a>
                    </td>
                }
            </tr>
        }
        </tbody>
    </table>}
<br/>
<div class="d-flex justify-content-end">
    <a class="btn btn-primary" asp-controller="Projects" asp-action="Add" role="button">Nuevo Proyecto</a>
</div>
