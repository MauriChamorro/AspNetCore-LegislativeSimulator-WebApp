@model List<ProjectViewModel>

@section title {
    <h1 class="display-4">Mis Proyectos</h1>
}

@{
    <table class="table">
        <thead>
        <tr>
            <th scope="col">Nro Expediente</th>
            <th scope="col">Título</th>
            <th scope="col">Estado</th>
            <th scope="col">Fecha Estado</th>
        </tr>
        </thead>
        <tbody>
        @foreach (var @projectVm in Model)
        {
            <tr>
                <th scope="row">@projectVm.ProjectId</th>
                <td>@projectVm.Title</td>
                <td>@projectVm.StateName</td>
                <td>@projectVm.StateDate.ToString("dd/MM/yyyy")</td>
                
                @if (projectVm.CanEdit)
                {
                    <td>
                        <a class="btn btn-success" asp-controller="Projects" asp-action="Edit" asp-route-projectId="@projectVm.ProjectId">Editar</a>
                    </td>
                }
                else
                {
                    <td>
                        <a class="btn btn-success" asp-controller="Projects" asp-action="Edit" asp-route-projectId="@projectVm.ProjectId">Ver</a>
                    </td>
                }
            </tr>
        }
        </tbody>
    </table>
}
<br/>
<a class="btn btn-primary" asp-controller="Projects" asp-action="Add" role="button">Nuevo Proyecto</a>