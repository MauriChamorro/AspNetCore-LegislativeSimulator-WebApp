@model List<Project>

@section title {
    <h1 class="display-4">Mis Proyectos</h1>
}

@{
    <table class="table">
        <thead>
        <tr>
            <th scope="col">Nro Expediente</th>
            <th scope="col">Título</th>
            <th scope="col">Estado</th>
            <th scope="col">Fecha Estado</th>
        </tr>
        </thead>
        <tbody>
        @foreach (var @project in Model)
        {
            <tr>
                <th scope="row">@project.Id</th>
                <td>@project.Title</td>
                <td>@project.State.ProjectStateName</td>
                <td>@project.State.ChangeDate.ToString("dd/MM/yyyy")</td>
                <td><!-- TODO: Segun el estado, mostrar ciertos botones -->
                    <a class="btn btn-success" asp-controller="Projects" asp-action="Edit" asp-route-id="@project.Id">Ver</a>
                </td>
            </tr>
        }
        </tbody>
    </table>
}
<br/>
<a class="btn btn-primary" asp-controller="Projects" asp-action="Add" role="button">Nuevo Proyecto</a>