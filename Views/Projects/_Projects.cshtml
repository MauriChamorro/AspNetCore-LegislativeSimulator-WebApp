@model ProjectViewModel

@{
    string action = Model.IsEdit ? "Edit" : "Add";
    string callToAction = Model.IsEdit ? "Actualizar" : "Crear";
    var readOnlyAttribute = Model.CanEdit ? null : "readonly";
}

@if (Model.IsEdit)
{
    <div class="d-flex justify-content-end">
        <a class="btn btn-danger confirm-modal"
           role="button"
           data-message="¿Quiere borrar el proyecto?"
           data-success-text="Borrar"
           data-url="@Url.Action("Delete", "Projects", new { id = Model.ProjectId })">
            Borrar
        </a>
    </div>
}
<form method="post" asp-controller="Projects" asp-action=@action id="formExpediente">
    <input type="hidden" asp-for="StateName"/>
    <input type="hidden" asp-for="StateDate"/>
    <input type="hidden" asp-for="CanEdit"/>
    <input type="hidden" asp-for="IsEdit"/>

    @if (Model.IsEdit)
    {
        <input type="hidden" asp-for="ProjectId"/>
    }
    @if (Model.IsEdit || !Model.CanEdit)
    {
        <div class="row mb-3">
            <div class="col-2">
                <label class="col-form-label">Nro Expediente</label>
            </div>
            <div class="col-sm-10">
                <input type="text" readonly class="form-control fw-bold" value="@Model.ProjectId">
            </div>
        </div>
    }

    <div id="title" class="row mb-3">
        <div class="col-sm-2">
            <label class="col-form-label">Título</label>
        </div>
        <div class="col-sm-10">
            <input type="text" asp-for="Title" class="form-control border p-2 pb-3 w-100"
                   readonly="@readOnlyAttribute"/>
            <span class="text-danger small" asp-validation-for="Title"></span>
        </div>
    </div>
    <div>
        <label asp-for="Articles" class="form-label mt-4">Artículos</label>
        <textarea class="form-control border p-2 pb-3" id="articles" rows="15" asp-for="Articles"
                 readonly="@readOnlyAttribute"></textarea>
        <div class="col">
            <span class="text-danger" asp-validation-for="Articles"></span>
        </div>
    </div>
    <div>
        <label asp-for="Fundaments" class="form-label mt-4">Fundamentos</label>
        <textarea class="form-control border p-2 pb-3" id="fundaments" rows="5" asp-for="Fundaments"
              readonly="@readOnlyAttribute"></textarea>
        <div class="col">
            <span class="text-danger" asp-validation-for="Fundaments"></span>
        </div>
    </div>
    <br/>

    <label asp-for="Summary" class="form-label mt-4">Resumen</label>
    <textarea class="form-control border p-2 pb-3" id="summary" rows="3" asp-for="Summary"
            readonly="@readOnlyAttribute"></textarea>
    <div class="col">
        <span class="text-danger" asp-validation-for="Summary"></span>
    </div>
    <br/>
    <div class="d-flex justify-content-between align-items-center">
        <a class="btn btn-info" href="javascript:history.back()" role="button">Volver</a>
        @if (Model.CanEdit)
        {
            <input type="submit" class="btn btn-primary" value="@callToAction"/>
        }
    </div>
    <br/>
    @if (Model.IsEdit)
    {
        <div class="d-flex justify-content-end">
            <a class="btn btn-warning confirm-modal"
               data-message="¿Enviar a Comisiones?"
               data-success-text="Enviar"
               data-url="@Url.Action("SendToCommission", "Projects", new { id = Model.ProjectId })"
               role="button">
                Enviar
            </a>
        </div>
    }
</form>
