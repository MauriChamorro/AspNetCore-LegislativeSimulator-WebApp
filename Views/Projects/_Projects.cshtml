@model ProjectViewModel

@{
    string action = ViewBag.Action ?? string.Empty;
    string callToAction = action.ToLower() == "edit" ? "Actualizar" : "Crear";
}

<form method="post" asp-controller="Projects" asp-action=@action>
    <input type="hidden" asp-for="StateName"/>
    <input type="hidden" asp-for="StateDate"/>
    <input type="hidden" asp-for="CanEdit"/>
    
    @if (action.ToLower() != "add")
    {
        <input type="hidden" asp-for="ProjectId"/>
    }
    @if (action.ToLower() != "add")
    {
        <div class="row mb-3">
            <div class="col-2">
                <label class="col-form-label">Nro Expediente</label>
            </div>
            <div class="col-sm-10">
                <input type="text" readonly="" class="form-control-plaintext fw-bold" value="@Model.ProjectId">
            </div>
        </div>
    }

    <div id="title" class="row mb-3">
        <div class="col-2">
            <label class="col-form-label">Título</label>
        </div>
        <div class="col-6">
            <input type="text" asp-for="Title" class="form-control" readonly="@(Model.CanEdit ? null : "readonly")"/>
        </div>
        <div class="col">
            <span class="text-danger" asp-validation-for="Title"></span>
        </div>
    </div>
    <div>
        <label asp-for="Articles" class="form-label mt-4">Artículos</label>
        <textarea class="form-control" id="articles" rows="5" asp-for="Articles" readonly="@(Model.CanEdit ? null : "readonly")"></textarea>
        <div class="col">
            <span class="text-danger" asp-validation-for="Articles"></span>
        </div>
    </div>
    <div>
        <label asp-for="Fundaments" class="form-label mt-4">Fundamentos</label>
        <textarea class="form-control" id="fundaments" rows="5" asp-for="Fundaments" readonly="@(Model.CanEdit ? null : "readonly")"></textarea>
        <div class="col">
            <span class="text-danger" asp-validation-for="Fundaments"></span>
        </div>
    </div>
    <br/>
    <div id="summary" class="row mb-3">
        <div class="col-2">
            <label class="col-form-label">Resumen</label>
        </div>
        <div class="col-6">
            <input type="text" asp-for="Summary" class="form-control" readonly="@(Model.CanEdit ? null : "readonly")"/>
        </div>
        <div class="col">
            <span class="text-danger" asp-validation-for="Summary"></span>
        </div>
    </div>
    
    <div class="d-flex justify-content-between align-items-center">
        <a class="btn btn-primary" asp-controller="Projects" asp-action="Index" role="button">Volver</a>
        @if (Model.CanEdit)
        { 
            <input type="submit" class="btn btn-success" value="@callToAction"/>
        }
    </div>
</form>