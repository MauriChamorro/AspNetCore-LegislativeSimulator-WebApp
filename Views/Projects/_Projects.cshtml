@model ProjectViewModel

@{
    string action = ViewBag.Action ?? string.Empty;
    string callToAction = action.ToLower() == "edit" ? "Actualizar" : "Crear";
}

@if (Model.ProjectId != 0 && Model.CanEdit)
{
    <div class="d-flex justify-content-end">
        <a class="btn btn-danger" role="button" onclick="confirmSending('¿Estás seguro que desea borrar el proyecto?','Borrar','@Url.Action("Delete", "Projects", new { id = Model.ProjectId })')">Borrar</a>
    </div>
}
<form method="post" asp-controller="Projects" asp-action=@action id="formExpediente">
    <input type="hidden" asp-for="StateName"/>
    <input type="hidden" asp-for="StateDate"/>
    <input type="hidden" asp-for="CanEdit"/>
    
    @if (action.ToLower() != "add")
    {
        <input type="hidden" asp-for="ProjectId"/>
    }
    @if (action.ToLower() != "add")
    {
        <div class="row mb-3">
            <div class="col-2">
                <label class="col-form-label">Nro Expediente</label>
            </div>
            <div class="col-sm-10">
                <input type="text" readonly="" class="form-control-plaintext fw-bold" value="@Model.ProjectId">
            </div>
        </div>
    }

    <div id="title" class="row mb-3">
        <div class="col-2">
            <label class="col-form-label">Título</label>
        </div>
        <div class="col-6">
            <input type="text" asp-for="Title" class="form-control border p-2 pb-3" readonly="@(Model.CanEdit ? null : "readonly")"/>
        </div>
        <div class="col">
            <span class="text-danger" asp-validation-for="Title"></span>
        </div>
    </div>
    <div>
        <label asp-for="Articles" class="form-label mt-4">Artículos</label>
        <textarea class="form-control border p-2 pb-3" id="articles" rows="15" asp-for="Articles" readonly="@(Model.CanEdit ? null : "readonly")"></textarea>
        <div class="col">
            <span class="text-danger" asp-validation-for="Articles"></span>
        </div>
    </div>
    <div>
        <label asp-for="Fundaments" class="form-label mt-4">Fundamentos</label>
        <textarea class="form-control border p-2 pb-3" id="fundaments" rows="5" asp-for="Fundaments" readonly="@(Model.CanEdit ? null : "readonly")"></textarea>
        <div class="col">
            <span class="text-danger" asp-validation-for="Fundaments"></span>
        </div>
    </div>
    <br/>
        
    <label asp-for="Summary" class="form-label mt-4">Resumen</label>
    <textarea class="form-control border p-2 pb-3" id="summary" rows="3" asp-for="Summary" readonly="@(Model.CanEdit ? null : "readonly")"></textarea>
    <div class="col">
        <span class="text-danger" asp-validation-for="Summary"></span>
    </div>
    <br/>
    <div class="d-flex justify-content-between align-items-center">
        <a class="btn btn-primary" asp-controller="Projects" asp-action="Index" role="button">Volver</a>
        @if (Model.CanEdit)
        { 
            <input type="submit" class="btn btn-info" value="@callToAction"/>
        }
    </div>
    <br/>
    @if (Model.ProjectId != 0 && Model.CanEdit)
    {
        <div class="d-flex justify-content-end">
            <a class="btn btn-success"
               id="send-to-commission-element"
               data-message="¿Enviar a Comisiones?"
               data-success-text="Enviar"
               data-url="@Url.Action("SendToCommission", "Projects", new { id = Model.ProjectId })"
               role="button">
                Enviar
            </a>
        </div>
    }
</form>
